bin/
obj/
.vs/
*.user

# Build output from "dotnet publish". Self-contained, several hundred MB.
publish/

# Model weights are large and licensed separately. The doctor fetches or places them.
# Anchored to the repo root on purpose. Windows sets core.ignorecase, so an unanchored
# "models/" also matches src/LocalScribe.Core/Models/ and drops the source silently.
/models/
*.onnx
*.bin

# For the same reason "*.onnx" matches the LocalScribe.Onnx *directory*. These two put back
# source that the weight patterns above swept up. On Linux neither line is needed, which is
# exactly why the collision survived this long.
!src/LocalScribe.Onnx/
!src/LocalScribe.Core/Models/
