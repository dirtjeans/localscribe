<Window
    x:Class="LocalScribe.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:LocalScribe.App"
    mc:Ignorable="d"
    Title="LocalScribe">

    <Grid AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="F" Invoked="OnFindAccelerator" />
            <KeyboardAccelerator Key="Escape" Invoked="OnEscapeAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="Space" Invoked="OnPlayAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="O" Invoked="OnOpenAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="S" Invoked="OnSaveAccelerator" />
        </Grid.KeyboardAccelerators>

        <Grid.Resources>
            <Storyboard x:Name="PulseStoryboard" RepeatBehavior="Forever" AutoReverse="True">
                <DoubleAnimation
                    Storyboard.TargetName="CueDot"
                    Storyboard.TargetProperty="Opacity"
                    From="1.0"
                    To="0.15"
                    Duration="0:0:0.65" />
            </Storyboard>

            <!-- The recording dot on the Stop button breathes while the microphone is live. -->
            <Storyboard x:Name="RecordingDotStoryboard" RepeatBehavior="Forever" AutoReverse="True">
                <DoubleAnimation
                    Storyboard.TargetName="RecordingDot"
                    Storyboard.TargetProperty="Opacity"
                    From="1.0"
                    To="0.25"
                    Duration="0:0:0.7" />
            </Storyboard>

            <!--
                Quiet until hovered, as the Mac's toolbar is: a row of filled slabs made every
                verb shout, and the things that could not be done yet — greyed slabs — loudest
                of all. Unavailable reads as faded instead.
            -->
            <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="ToolbarIconButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
                <Setter Property="Padding" Value="9,7" />
            </Style>

            <Style x:Key="StepLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
            <Style x:Key="StepState" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Margin" Value="6,0,0,0" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            The title bar carries the whole toolbar, as on the Mac. The verbs that start
            everything keep their words on the left; the document's name sits in the middle,
            which is the only part that drags the window; the tools for the open transcript are
            glyphs on the right, named by their tooltips. The last column keeps clear of the
            caption buttons, sized in code from what Windows reports.
        -->
        <Grid x:Name="TitleBar" Grid.Row="0" Height="48" Padding="8,0,0,0">
            <Grid.Resources>
                <!-- Lightweight styling: no slab behind a disabled toolbar verb. -->
                <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="48" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="CaptionColumn" Width="138" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <Button x:Name="OpenFileButton" Style="{StaticResource ToolbarButton}" Click="OnOpen"
                        ToolTipService.ToolTip="Open a recording or a saved transcript (Ctrl+O)">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8E5;" FontSize="15" />
                        <TextBlock Text="Open" />
                    </StackPanel>
                </Button>

                <Button x:Name="StartButton" Style="{StaticResource ToolbarButton}" Click="OnToggleRecording"
                        IsEnabled="False">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon x:Name="StartIcon" Glyph="&#xE720;" FontSize="15" />
                        <TextBlock x:Name="StartLabel" Text="Record" />
                    </StackPanel>
                </Button>

                <!--
                    Red while the microphone is live: the one colour that means recording, on
                    the control someone looks at when they wonder whether it is. Overriding the
                    brushes the template looks up is the only way to hold it through hover and
                    press, and those overrides live on the control.
                -->
                <Button x:Name="StopButton" Click="OnToggleRecording" Style="{ThemeResource AccentButtonStyle}"
                        VerticalAlignment="Center" Padding="12,6" Visibility="Collapsed">
                    <Button.Resources>
                        <SolidColorBrush x:Key="AccentButtonBackground" Color="#C42B1C" />
                        <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#B0271A" />
                        <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#96201A" />
                        <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="#C42B1C" />
                        <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="#B0271A" />
                        <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="#96201A" />
                        <SolidColorBrush x:Key="AccentButtonForeground" Color="White" />
                        <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="White" />
                        <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="White" />
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse x:Name="RecordingDot" Width="9" Height="9" Fill="White" VerticalAlignment="Center" />
                        <TextBlock Text="Stop" />
                    </StackPanel>
                </Button>

                <!-- Only ever relevant to work in progress, so it only ever appears with it. -->
                <Button x:Name="CancelButton" Style="{StaticResource ToolbarButton}" Click="OnCancel"
                        Content="Cancel" Visibility="Collapsed" />
            </StackPanel>

            <!--
                The document's name, with what a reader wants before opening it: how long it is
                and how many people are in it. Also the drag handle — the only part of this row
                that is not a control.
            -->
            <Grid x:Name="TitleDragRegion" Grid.Column="1" Background="Transparent">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12,0">
                    <TextBlock x:Name="TitleText" Text="LocalScribe" FontWeight="SemiBold" FontSize="13"
                               HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="SubtitleText" FontSize="11" HorizontalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Visibility="Collapsed"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <TextBlock x:Name="SearchCount" VerticalAlignment="Center" Margin="0,0,8,0"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Style="{ThemeResource CaptionTextBlockStyle}" />

                <TextBox x:Name="SearchBox" Width="180" Margin="0,0,6,0" VerticalAlignment="Center"
                         PlaceholderText="Search" TextChanged="OnSearchChanged"
                         ToolTipService.ToolTip="Search the transcript (Ctrl+F)" />

                <Button x:Name="SpeakersButton" Style="{StaticResource ToolbarIconButton}" Click="OnEditSpeakers"
                        IsEnabled="False" AutomationProperties.Name="Speakers">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE716;" FontSize="15" />

                        <!-- How many were found. Quiet enough to ignore when it is right, and
                             on the control that fixes it when it is not. -->
                        <Border x:Name="SpeakerCountBadge" Background="{ThemeResource AccentFillColorDefaultBrush}"
                                CornerRadius="8" MinWidth="16" Height="16" Padding="4,0"
                                VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock x:Name="SpeakerCountText" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </Button>

                <!-- How hard making a transcript may work the machine. Set once and left. -->
                <Button x:Name="PaceButton" Style="{StaticResource ToolbarIconButton}"
                        ToolTipService.ToolTip="Processing speed — how much of the machine to spend"
                        AutomationProperties.Name="Processing speed">
                    <FontIcon Glyph="&#xEC4A;" FontSize="15" />
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight" Opening="OnPaceFlyoutOpening">
                            <StackPanel Width="320" Spacing="8">
                                <TextBlock Text="Processing speed" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <Slider
                                    x:Name="PaceSlider"
                                    Minimum="0"
                                    Maximum="3"
                                    StepFrequency="1"
                                    TickFrequency="1"
                                    TickPlacement="Outside"
                                    SnapsTo="Ticks"
                                    IsThumbToolTipEnabled="False"
                                    AutomationProperties.Name="Processing speed"
                                    ValueChanged="OnPaceChanged" />
                                <Grid Margin="0,-4,0,0">
                                    <TextBlock Text="Lighter on this PC" Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.7" HorizontalAlignment="Left" />
                                    <TextBlock Text="Faster" Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.7" HorizontalAlignment="Right" />
                                </Grid>
                                <TextBlock x:Name="PaceDescriptionText" TextWrapping="Wrap" />
                                <TextBlock
                                    Text="Takes effect from the next transcription or recording."
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Opacity="0.7"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <Border Width="1" Height="18" Margin="5,0" VerticalAlignment="Center"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <Button x:Name="CopyButton" Style="{StaticResource ToolbarIconButton}" Click="OnCopy" IsEnabled="False"
                        ToolTipService.ToolTip="Copy — the selected text, or the whole transcript when nothing is selected"
                        AutomationProperties.Name="Copy">
                    <FontIcon Glyph="&#xE8C8;" FontSize="15" />
                </Button>

                <Button x:Name="SaveButton" Style="{StaticResource ToolbarIconButton}" Click="OnSave" IsEnabled="False"
                        ToolTipService.ToolTip="Save — the transcript and its audio together, or the words alone (Ctrl+S)"
                        AutomationProperties.Name="Save">
                    <FontIcon Glyph="&#xE74E;" FontSize="15" />
                </Button>

                <Button x:Name="DiscardButton" Style="{StaticResource ToolbarIconButton}" Click="OnDiscard" IsEnabled="False"
                        ToolTipService.ToolTip="Discard — throw the transcript away"
                        AutomationProperties.Name="Discard">
                    <FontIcon Glyph="&#xE74D;" FontSize="15" />
                </Button>
            </StackPanel>
        </Grid>

        <!--
            Whether the microphone is actually running is the one thing the user has to know.
            Anything said while the model is loading is lost rather than delayed, so the two
            states get saturated backgrounds with white text: unmistakable at a glance, and
            legible in either theme without depending on which one is active.
        -->
        <Border
            x:Name="CueBanner"
            Grid.Row="1"
            Margin="24,4,24,4"
            CornerRadius="8"
            Padding="20,16"
            Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <!-- Pulses while listening, steady while waiting. Motion reads before text. -->
                <Ellipse x:Name="CueDot" Width="18" Height="18" Fill="White" VerticalAlignment="Center" />
                <StackPanel Spacing="2">
                    <TextBlock x:Name="CueTitle" FontSize="22" FontWeight="SemiBold" Foreground="White" />
                    <TextBlock x:Name="CueDetail" FontSize="14" Foreground="White" Opacity="0.92" TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="14,4,14,8">
            <!--
                One item per paragraph rather than one long block of text. Paragraphs are what
                make a transcript readable, and giving each its own item is also what lets a
                click land on a time. The list spans the window, so its scroll bar sits at the
                edge where a hand reaches for it; each row holds itself to a reading column in
                the middle, because a line the width of a wide window is one the eye loses on
                the way back.
            -->
            <ListView
                x:Name="TranscriptList"
                SelectionMode="Single"
                IsItemClickEnabled="True"
                ItemClick="OnParagraphClick"
                ContainerContentChanging="OnContainerContentChanging"
                ShowsScrollingPlaceholders="False">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:ParagraphView">
                        <Grid ColumnSpacing="16" Padding="0,10" MaxWidth="840">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!--
                                Where the paragraph starts, in a fixed gutter so the text starts
                                on the same line down the whole transcript.
                            -->
                            <TextBlock
                                Grid.Column="0"
                                Text="{x:Bind Clock}"
                                FontFamily="Consolas"
                                FontSize="12"
                                VerticalAlignment="Top"
                                Margin="0,4,0,0"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                            <StackPanel Grid.Column="1" Spacing="3">
                                <!--
                                    A button, because a machine-guessed name is a first draft:
                                    diarization splits one person in two often enough that
                                    correcting a label has to be as easy as reading it. Each
                                    voice keeps its own colour (see SpeakerBrush), so a change
                                    of speaker is seen before it is read.
                                -->
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <HyperlinkButton
                                        Tag="speaker"
                                        Content="{x:Bind Speaker}"
                                        Visibility="{x:Bind HasSpeaker}"
                                        Click="OnRenameSpeaker"
                                        Padding="0"
                                        FontWeight="SemiBold"
                                        FontSize="12.5"
                                        ToolTipService.ToolTip="Rename" />

                                    <!--
                                        Said over somebody else: the wording and the name are
                                        both less certain here, and a reader about to quote the
                                        line should know.
                                    -->
                                    <Border
                                        Visibility="{x:Bind OverlapVisibility}"
                                        Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                        CornerRadius="4"
                                        Padding="6,1"
                                        VerticalAlignment="Center">
                                        <TextBlock
                                            Text="people talking over each other"
                                            FontSize="11"
                                            Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                    </Border>
                                </StackPanel>

                                <!--
                                    Selectable from the moment it appears: quoting a line is half
                                    of what a transcript is for. A selectable block takes the
                                    pointer for itself, so the click is found here instead (see
                                    OnBodyReleased), and a right-click offers to correct the word
                                    under it (see FillCorrectionMenu).
                                -->
                                <TextBlock
                                    Tag="body"
                                    IsTextSelectionEnabled="True"
                                    TextWrapping="Wrap"
                                    FontSize="15"
                                    LineHeight="25" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!--
                The working glow: three colours, each owning about a third of the border, the
                whole turning slowly and breathing while the models are busy. WinUI has no blur
                to make a halo of, so the halo is built as one: a crisp ring at the transcript's
                edge and a stack of one-pixel rings stepping outward, each fainter than the
                last on a Gaussian, drawn in code into this cell (see BuildGlow).
            -->
            <Grid x:Name="AiGlowHost" IsHitTestVisible="False" Visibility="Collapsed" />

            <!-- What an empty window offers: the two ways in, and the promise that matters. -->
            <StackPanel
                x:Name="EmptyState"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                MaxWidth="460"
                Spacing="14">
                <Border Width="64" Height="64" CornerRadius="32" HorizontalAlignment="Center"
                        Background="{ThemeResource AccentFillColorTertiaryBrush}" Opacity="0.9">
                    <PathIcon Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                              Data="M11,3 L13,3 L13,21 L11,21 Z M7,7 L9,7 L9,17 L7,17 Z M15,6 L17,6 L17,18 L15,18 Z M3,10 L5,10 L5,14 L3,14 Z M19,9 L21,9 L21,15 L19,15 Z" />
                </Border>
                <TextBlock Text="Transcribe a recording" HorizontalAlignment="Center"
                           Style="{ThemeResource SubtitleTextBlockStyle}" />
                <TextBlock
                    Text="Open an audio or video file, or a saved transcript — or drop one here. Words, speakers and timing are worked out on this PC, and nothing leaves it."
                    TextWrapping="Wrap"
                    TextAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{ThemeResource BodyTextBlockStyle}" />
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,4,0,0">
                    <Button x:Name="EmptyOpenButton" Style="{ThemeResource AccentButtonStyle}" Click="OnOpen" Padding="16,7">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                            <TextBlock Text="Open…" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="EmptyRecordButton" Click="OnToggleRecording" Padding="16,7" IsEnabled="False">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE720;" FontSize="14" />
                            <TextBlock Text="Record" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>

            <!-- Words still moving. Dimmed, because showing them as settled is a small lie. -->
            <TextBlock
                x:Name="ProvisionalTextBlock"
                Text=""
                TextWrapping="Wrap"
                FontStyle="Italic"
                FontSize="15"
                LineHeight="25"
                MaxWidth="768"
                VerticalAlignment="Bottom"
                Margin="72,0,0,8"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
        </Grid>

        <!--
            A run's steps, each with its own bar: they overlap and finish in no fixed order, so
            one bar for all of them could only ever show an invented number. The line below says
            what the reader can already do, because a progress bar otherwise reads as "wait".
        -->
        <StackPanel x:Name="StepsPanel" Grid.Row="3" Margin="28,0,28,10" Spacing="7" Visibility="Collapsed">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="StepLabel0" Style="{StaticResource StepLabel}" />
                        <TextBlock x:Name="StepState0" Grid.Column="1" Style="{StaticResource StepState}" />
                    </Grid>
                    <ProgressBar x:Name="StepBar0" Maximum="1" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="StepLabel1" Style="{StaticResource StepLabel}" />
                        <TextBlock x:Name="StepState1" Grid.Column="1" Style="{StaticResource StepState}" />
                    </Grid>
                    <ProgressBar x:Name="StepBar1" Maximum="1" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="StepLabel2" Style="{StaticResource StepLabel}" />
                        <TextBlock x:Name="StepState2" Grid.Column="1" Style="{StaticResource StepState}" />
                    </Grid>
                    <ProgressBar x:Name="StepBar2" Maximum="1" />
                </StackPanel>
            </Grid>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ProgressHintText" TextWrapping="Wrap" VerticalAlignment="Center"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
                <!-- Here because this is where someone decides to go and do something else. -->
                <CheckBox x:Name="AlertCheck" Grid.Column="1" Content="Alert me when it's done" FontSize="12"
                          MinHeight="0" MinWidth="0" Padding="6,0,0,0" VerticalAlignment="Center"
                          Click="OnAlertToggled"
                          ToolTipService.ToolTip="A notification and a flashing taskbar button when this run ends, if you're in another window" />
            </Grid>
        </StackPanel>

        <!-- The transport lives with the thing it transports: a player-shaped card. -->
        <Border
            x:Name="TransportBar"
            Grid.Row="4"
            Margin="24,0,24,8"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Padding="10,8"
            Visibility="Collapsed">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- The one filled control in the window: the thing a listener reaches for. -->
                <Button x:Name="PlayButton" Grid.Column="0" Click="OnPlayPause"
                        Style="{ThemeResource AccentButtonStyle}"
                        Width="38" Height="38" CornerRadius="19" Padding="0" VerticalAlignment="Center">
                    <FontIcon x:Name="PlayIcon" Glyph="&#xE768;" FontSize="14" />
                </Button>

                <!--
                    The recording drawn as its own shape. Where someone spoke and where they
                    stopped is visible without reading anything, which is what makes it worth
                    scrubbing along. Dragging moves the transcript highlight whether or not
                    anything is playing — the two are one thing seen twice.
                -->
                <Grid
                    x:Name="Waveform"
                    Grid.Column="1"
                    Height="44"
                    Background="Transparent"
                    SizeChanged="OnWaveformSizeChanged"
                    PointerPressed="OnWaveformPressed"
                    PointerMoved="OnWaveformMoved"
                    PointerReleased="OnWaveformReleased"
                    PointerCaptureLost="OnWaveformReleased"
                    Tapped="OnWaveformTapped">

                    <!-- The drawing is not the control: shapes hit-test by default, and the grid
                         underneath is what handles scrubbing. -->
                    <Polygon x:Name="WaveformShape" IsHitTestVisible="False"
                             Fill="{ThemeResource TextFillColorDisabledBrush}" />

                    <!-- The same shape again, clipped to what has played. -->
                    <Polygon x:Name="WaveformPlayed" IsHitTestVisible="False"
                             Fill="{ThemeResource AccentFillColorDefaultBrush}" />

                    <!-- Where the search term is said. Under the playhead, over the waveform. -->
                    <Canvas x:Name="WaveformMarks" IsHitTestVisible="False" />

                    <Rectangle x:Name="Playhead" Width="2" IsHitTestVisible="False" HorizontalAlignment="Left"
                               Fill="{ThemeResource TextFillColorPrimaryBrush}" />
                </Grid>

                <TextBlock
                    x:Name="TransportClock"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Margin="0,0,4,0"
                    FontFamily="Consolas"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{ThemeResource CaptionTextBlockStyle}" />
            </Grid>
        </Border>

        <!--
            The status gets the line; the models get a chip. The model roster is a question
            asked now and then — "is it really using the NPU?" — while the status is read
            constantly, so the chip names the models in a word each and opens the full roster
            on click. The bar is for single jobs, such as comparing voices, that have only one
            number to give; a run shows its steps instead.
        -->
        <Border Grid.Row="5" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"
                Padding="24,4,14,6">
            <Grid ColumnSpacing="16" RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ProgressBar
                    x:Name="ProgressBarControl"
                    Grid.Row="0"
                    Grid.ColumnSpan="2"
                    Value="0"
                    Maximum="1"
                    Visibility="Collapsed" />

                <TextBlock
                    x:Name="StatusText"
                    Grid.Row="1"
                    Grid.Column="0"
                    Text="Starting up…"
                    VerticalAlignment="Center"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    TextWrapping="NoWrap"
                    TextTrimming="CharacterEllipsis"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <!--
                    Offered rather than asked about, and only once there is something to offer:
                    the language is not known until the recording has been listened to.
                -->
                <ToggleButton
                    x:Name="TranslateButton"
                    Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    HorizontalAlignment="Center"
                    Visibility="Collapsed"
                    Content="Translate to English"
                    Click="OnToggleTranslate"
                    ToolTipService.ToolTip="Transcribes the recording again, in English. Turning it off transcribes it again as spoken." />

                <Button
                    x:Name="ModelsChip"
                    Grid.Row="1"
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    Padding="8,2"
                    MinHeight="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Opacity="0.7"
                    Visibility="Collapsed"
