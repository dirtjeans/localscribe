<Window
    x:Class="LocalScribe.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:LocalScribe.App"
    mc:Ignorable="d"
    Title="LocalScribe">

    <Grid Padding="24" RowSpacing="16" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="F" Invoked="OnFindAccelerator" />
            <KeyboardAccelerator Key="Escape" Invoked="OnEscapeAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="Space" Invoked="OnPlayAccelerator" />
        </Grid.KeyboardAccelerators>

        <Grid.Resources>
            <Storyboard x:Name="PulseStoryboard" RepeatBehavior="Forever" AutoReverse="True">
                <DoubleAnimation
                    Storyboard.TargetName="CueDot"
                    Storyboard.TargetProperty="Opacity"
                    From="1.0"
                    To="0.15"
                    Duration="0:0:0.65" />
            </Storyboard>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            Two groups, not one row. The left makes a transcript; the right does something with
            the one you have, and every button in it is dead until there is one. Reading them as
            a single list of seven meant hunting for the two that mattered at any moment.
        -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Making a transcript. -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                <!--
                    Two buttons rather than one recoloured at runtime. The Button template swaps
                    its own background on hover and press, so a locally set colour survives only
                    until the pointer touches it; overriding the brushes the template looks up is
                    the only way to hold a colour through every state, and those overrides live
                    on the control.
                -->
                <Button x:Name="StartButton" Click="OnToggleRecording" Style="{ThemeResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon x:Name="StartIcon" Glyph="&#xE720;" FontSize="16" />
                        <TextBlock x:Name="StartLabel" Text="Start listening" />
                    </StackPanel>
                </Button>

                <Button
                    x:Name="StopButton"
                    Click="OnToggleRecording"
                    Style="{ThemeResource AccentButtonStyle}"
                    Visibility="Collapsed">
                    <!-- Windows' own critical red, held through hover, press and keyboard focus. -->
                    <Button.Resources>
                        <SolidColorBrush x:Key="AccentButtonBackground" Color="#C42B1C" />
                        <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#B0271A" />
                        <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#96201A" />
                        <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="#C42B1C" />
                        <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="#B0271A" />
                        <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="#96201A" />
                        <SolidColorBrush x:Key="AccentButtonForeground" Color="White" />
                        <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="White" />
                        <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="White" />
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse Width="12" Height="12" Fill="White" VerticalAlignment="Center" />
                        <TextBlock Text="Stop listening" />
                    </StackPanel>
                </Button>

                <Button x:Name="OpenFileButton" Click="OnOpenFile">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8E5;" FontSize="16" />
                        <TextBlock Text="Open a recording" />
                    </StackPanel>
                </Button>

                <!-- Only ever relevant to work in progress, so it only ever appears with it. -->
                <Button
                    x:Name="CancelButton"
                    Click="OnCancel"
                    Content="Cancel"
                    Visibility="Collapsed" />
            </StackPanel>

            <!-- Doing something with the transcript you have. -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button x:Name="SpeakersButton" Click="OnEditSpeakers" IsEnabled="False">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE716;" FontSize="16" />
                        <TextBlock Text="Speakers" />

                        <!-- How many were found. Quiet enough to ignore when it is right, and
                             right next to the control that fixes it when it is not. -->
                        <Border
                            x:Name="SpeakerCountBadge"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            CornerRadius="9"
                            MinWidth="18"
                            Height="18"
                            Padding="5,0"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                            <TextBlock
                                x:Name="SpeakerCountText"
                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                FontSize="11"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </Button>

                <Button x:Name="GlossaryButton" Content="Glossary" Click="OnEditGlossary" />

                <!--
                    Off unless asked. Whisper renders speech as English in the same pass that
                    recognises it, so this is a choice made before transcribing rather than a
                    second step afterwards — and it is English-only, because that is the only
                    target the model has.
                -->
                <ToggleButton
                    x:Name="TranslateButton"
                    Content="Translate to English"
                    Click="OnToggleTranslate"
                    ToolTipService.ToolTip="Write the transcript in English, whatever language is spoken. Off, it keeps the language spoken." />

                <AppBarSeparator />

                <Button x:Name="CopyButton" Click="OnCopy" IsEnabled="False">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8C8;" FontSize="16" />
                        <TextBlock Text="Copy" />
                    </StackPanel>
                </Button>

                <Button x:Name="SaveButton" Click="OnSave" IsEnabled="False">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74E;" FontSize="16" />
                        <TextBlock Text="Save" />
                    </StackPanel>
                </Button>

                <Button x:Name="DiscardButton" Click="OnDiscard" IsEnabled="False">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74D;" FontSize="16" />
                        <TextBlock Text="Discard" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!--
            Whether the microphone is actually running is the one thing the user has to know, and
            the earlier thin banner did not carry it. Anything said while the model is loading is
            lost rather than delayed, so the two states are given saturated backgrounds with
            white text: unmistakable at a glance, and legible in either theme without depending
            on which one is active.
        -->
        <Border
            x:Name="CueBanner"
            Grid.Row="1"
            CornerRadius="8"
            Padding="20,16"
            Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <!-- Pulses while listening, steady while waiting. Motion reads before text. -->
                <Ellipse x:Name="CueDot" Width="18" Height="18" Fill="White" VerticalAlignment="Center" />
                <StackPanel Spacing="2">
                    <TextBlock
                        x:Name="CueTitle"
                        FontSize="22"
                        FontWeight="SemiBold"
                        Foreground="White" />
                    <TextBlock
                        x:Name="CueDetail"
                        FontSize="14"
                        Foreground="White"
                        Opacity="0.92"
                        TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </Border>

<!--
            What cleanup could not do, said where the transcript is rather than in the status
            line, which scrolls away and is read by nobody. Only appears when there is something
            to say: an unpunctuated passage otherwise looks like the recording was unclear rather
            than like a stage that failed and can be run again.
        -->
        <Border
            x:Name="CleanupNotice"
            Grid.Row="2"
            CornerRadius="8"
            Padding="16,12"
            Margin="0,0,0,12"
            Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
            BorderBrush="{ThemeResource SystemFillColorCautionBrush}"
            BorderThickness="1"
            Visibility="Collapsed">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    x:Name="CleanupNoticeText"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    TextWrapping="Wrap"
                    Style="{ThemeResource BodyTextBlockStyle}" />

                <Button
                    x:Name="RetryCleanupButton"
                    Grid.Column="1"
                    Content="Try again"
                    VerticalAlignment="Center"
                    Click="OnRetryCleanup" />
            </Grid>
        </Border>

        <Grid Grid.Row="3" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Finding a moment in a long transcript, then clicking it to hear it. -->
            <Grid Grid.Row="0" ColumnSpacing="12" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox
                    x:Name="SearchBox"
                    Grid.Column="0"
                    PlaceholderText="Search the transcript"
                    TextChanged="OnSearchChanged" />

                <TextBlock
                    x:Name="SearchCount"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{ThemeResource CaptionTextBlockStyle}" />
            </Grid>

            <!--
                One item per paragraph rather than one long block of text. Paragraphs are what
                make a transcript readable, and giving each its own item is also what lets a
                click land on a time: the timestamp beside it is the position in the recording,
                so the text and the audio stay the same object rather than two views of one.
            -->
            <ListView
                x:Name="TranscriptList"
                Grid.Row="1"
                SelectionMode="Single"
                IsItemClickEnabled="True"
                ItemClick="OnParagraphClick"
                ContainerContentChanging="OnContainerContentChanging"
                ShowsScrollingPlaceholders="False">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:ParagraphView">
                        <Grid ColumnSpacing="16" Padding="0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!--
                                The timestamp sits in a fixed gutter so the text starts on the
                                same line down the whole transcript. Ragged left margins are what
                                make a transcript tiring to read.
                            -->
                            <TextBlock
                                Grid.Column="0"
                                Text="{x:Bind Clock}"
                                FontFamily="Consolas"
                                FontSize="12"
                                VerticalAlignment="Top"
                                Margin="0,3,0,0"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                            <StackPanel Grid.Column="1" Spacing="3">
                                <!--
                                    A button, because a machine-guessed name is a first draft.
                                    Diarization splits one person in two often enough that
                                    correcting a label has to be as easy as reading it.
                                -->
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <HyperlinkButton
                                        Content="{x:Bind Speaker}"
                                        Visibility="{x:Bind HasSpeaker}"
                                        Click="OnRenameSpeaker"
                                        Padding="0"
                                        FontWeight="SemiBold"
                                        FontSize="12" />

                                    <!--
                                        Said over somebody else. The words here came out of two
                                        voices at once, so both the wording and the name on it
                                        are less certain than the rest of the transcript, and a
                                        reader about to quote the line should know.
                                    -->
                                    <Border
                                        Visibility="{x:Bind OverlapVisibility}"
                                        Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                        CornerRadius="4"
                                        Padding="6,1"
                                        VerticalAlignment="Center">
                                        <TextBlock
                                            Text="people talking over each other"
                                            FontSize="11"
                                            Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                    </Border>
                                </StackPanel>

                                <!--
                                    Held to a readable measure rather than the width of the
                                    window, and deliberately not selectable: a TextBlock with
                                    text selection on consumes the pointer, and inside a list
                                    item that means the item is never clicked, which is exactly
                                    why clicking a line once played nothing.
                                -->
                                <TextBlock
                                    Tag="body"
                                    TextWrapping="Wrap"
                                    MaxWidth="760"
                                    HorizontalAlignment="Left"
                                    LineHeight="24"
                                    Style="{ThemeResource BodyTextBlockStyle}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel
                x:Name="EmptyState"
                Grid.Row="1"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                MaxWidth="420"
                Spacing="10">
                <!-- A microphone, not a music note. This is a transcriber; the note read as a
                     media player, and it also spoke only for half of what the panel offers. The
                     microphone matches the button that starts the thing. -->
                <FontIcon
                    Glyph="&#xE720;"
                    FontSize="32"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock
                    Text="Nothing transcribed yet"
                    HorizontalAlignment="Center"
                    Style="{ThemeResource SubtitleTextBlockStyle}" />
                <TextBlock
                    Text="Start listening to transcribe as you speak, or drop an audio or video file here. Everything runs on this machine."
                    TextWrapping="Wrap"
                    TextAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{ThemeResource BodyTextBlockStyle}" />
            </StackPanel>

            <!-- Words still moving. Dimmed, because showing them as settled is a small lie. -->
            <TextBlock
                x:Name="ProvisionalTextBlock"
                Grid.Row="1"
                Text=""
                TextWrapping="Wrap"
                FontStyle="Italic"
                VerticalAlignment="Bottom"
                Margin="0,0,0,8"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Style="{ThemeResource BodyTextBlockStyle}" />
        </Grid>

        <Border
            x:Name="TransportBar"
            Grid.Row="4"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12,8"
            Visibility="Collapsed">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="PlayButton" Grid.Column="0" Click="OnPlayPause" Width="44">
                    <FontIcon x:Name="PlayIcon" Glyph="&#xE768;" FontSize="16" />
                </Button>

                <!--
                    The recording drawn as its own shape. Where someone spoke and where they
                    stopped is visible without reading anything, which is what makes it worth
                    scrubbing along: the target is usually "just after that gap" rather than
                    "four minutes eleven". Dragging moves the transcript highlight whether or
                    not anything is playing — the two are one thing seen twice.
                -->
                <Grid
                    x:Name="Waveform"
                    Grid.Column="1"
                    Height="48"
                    Background="Transparent"
                    SizeChanged="OnWaveformSizeChanged"
                    PointerPressed="OnWaveformPressed"
                    PointerMoved="OnWaveformMoved"
                    PointerReleased="OnWaveformReleased"
                    PointerCaptureLost="OnWaveformReleased"
                    Tapped="OnWaveformTapped">

                    <!--
                        The drawing is not the control. Shapes are hit-testable by default, so
                        without this the pointer lands on a polygon and the grid underneath —
                        the thing that actually handles scrubbing — never hears about it.
                    -->
                    <Polygon
                        x:Name="WaveformShape"
                        IsHitTestVisible="False"
                        Fill="{ThemeResource TextFillColorDisabledBrush}" />

                    <!-- The same shape again, clipped to what has played. -->
                    <Polygon
                        x:Name="WaveformPlayed"
                        IsHitTestVisible="False"
                        Fill="{ThemeResource AccentFillColorDefaultBrush}" />

                    <!-- Where the search term is said. Under the playhead, over the waveform. -->
                    <Canvas x:Name="WaveformMarks" IsHitTestVisible="False" />

                    <Rectangle
                        x:Name="Playhead"
                        Width="2"
                        IsHitTestVisible="False"
                        HorizontalAlignment="Left"
                        Fill="{ThemeResource TextFillColorPrimaryBrush}" />
                </Grid>

                <TextBlock
                    x:Name="TransportClock"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontFamily="Consolas"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{ThemeResource CaptionTextBlockStyle}" />
            </Grid>
        </Border>

        <!--
            The status line, and beside it where the work is running. That second thing used to
            have a card at the top of the window, which gave the most technical sentence in the
            app the most prominent position in it. It still matters — "is it really using the
            NPU?" is the question everyone asks — so it stays visible, in the corner, at the size
            of a footnote.
        -->
        <Grid Grid.Row="5" ColumnSpacing="16" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ProgressBar
                x:Name="ProgressBarControl"
                Grid.Row="0"
                Grid.ColumnSpan="2"
                Value="0"
                Maximum="1" />

            <TextBlock
                x:Name="StatusText"
                Grid.Row="1"
                Grid.Column="0"
                Text="Starting up…"
                TextTrimming="CharacterEllipsis"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <TextBlock
                x:Name="HardwareText"
                Grid.Row="1"
                Grid.Column="1"
                Text="Checking…"
                HorizontalAlignment="Right"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
        </Grid>
    </Grid>
</Window>
