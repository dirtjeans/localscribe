<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>LocalScribe.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!--
      Embedded in the exe so Explorer, the taskbar and any shortcut pick it up without the file
      having to travel alongside. Regenerate with tools/make-icon.py.
    -->
    <ApplicationIcon>Assets\localscribe.ico</ApplicationIcon>

    <!--
      arm64 first: this app exists for Snapdragon laptops, and an x64 build running under
      emulation cannot load the QNN provider at all. x64 stays available so the UI can be
      worked on from an ordinary desktop, where it falls back to the CPU.
    -->
    <Platforms>arm64;x64</Platforms>
    <RuntimeIdentifiers>win-arm64;win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>

    <!--
      The .NET runtime ships in the folder too, for the same reason the Windows App SDK does.
      This app is a folder someone is handed, not something installed; published framework-
      dependent it runs only while the machine happens to hold a matching .NET Desktop runtime,
      and stops with an "install .NET" dialog the day an update removes it. The folder already
      carries models a hundred times this size.
    -->
    <SelfContained>true</SelfContained>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.240923002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />

    <!-- WASAPI capture and audio file decoding. Ships arm64-compatible managed assemblies. -->
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\localscribe.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\localscribe.png" CopyToOutputDirectory="PreserveNewest" />

    <!--
      The icon Explorer shows on saved .scrb transcripts. Shipped as a file beside the exe
      rather than embedded, because the registry's DefaultIcon points at a path and a plain
      .ico keeps tools/register-scrb.ps1 independent of resource indexes. Regenerate with
      tools/make-scrb-icon.py.
    -->
    <Content Include="Assets\scrb.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\scrb.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../LocalScribe.Core/LocalScribe.Core.csproj" />
    <ProjectReference Include="../LocalScribe.Onnx/LocalScribe.Onnx.csproj" />
  </ItemGroup>

</Project>
