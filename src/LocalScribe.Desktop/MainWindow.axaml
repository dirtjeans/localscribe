<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LocalScribe.Desktop.MainWindow"
        Title="LocalScribe"
        Width="980" Height="720"
        MinWidth="600" MinHeight="420"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="52"
        Background="{DynamicResource WindowBg}"
        DragDrop.AllowDrop="True">

  <!--
    The chrome follows the platform rather than the Windows window: the toolbar shares the
    title bar with the traffic lights, buttons are quiet until hovered, and everything that
    can be clicked says so on approach. The *behaviours* stay the ported ones — the design is
    a coat, not a rewrite.
  -->

  <Window.Resources>
    <ResourceDictionary>

    <!-- Simple filled glyphs, drawn for 24×24. Kept as paths rather than a font so the app
         stays self-contained and the icons render identically on every machine. -->
    <StreamGeometry x:Key="IconOpen">M2,6 C2,4.9 2.9,4 4,4 L9,4 L11,6 L20,6 C21.1,6 22,6.9 22,8 L22,18 C22,19.1 21.1,20 20,20 L4,20 C2.9,20 2,19.1 2,18 Z</StreamGeometry>
    <StreamGeometry x:Key="IconMic">M12,3 A3,3 0 0 1 15,6 L15,11 A3,3 0 0 1 9,11 L9,6 A3,3 0 0 1 12,3 Z M7,11 A5,5 0 0 0 17,11 L19,11 A7,7 0 0 1 13,17.93 L13,21 L11,21 L11,17.93 A7,7 0 0 1 5,11 Z</StreamGeometry>
    <StreamGeometry x:Key="IconPlay">M8,5 L19,12 L8,19 Z</StreamGeometry>
    <StreamGeometry x:Key="IconPause">M7,5 L10.5,5 L10.5,19 L7,19 Z M13.5,5 L17,5 L17,19 L13.5,19 Z</StreamGeometry>
    <StreamGeometry x:Key="IconStop">M7,7 L17,7 L17,17 L7,17 Z</StreamGeometry>
    <StreamGeometry x:Key="IconSave">M11,3 L13,3 L13,11 L16,11 L12,15 L8,11 L11,11 Z M4,17 L20,17 L20,19 L4,19 Z</StreamGeometry>
    <StreamGeometry x:Key="IconExport">M11,15 L13,15 L13,7 L16,7 L12,3 L8,7 L11,7 Z M4,17 L20,17 L20,19 L4,19 Z</StreamGeometry>
    <StreamGeometry x:Key="IconPeople">M9,4 A3,3 0 0 1 9,10 A3,3 0 0 1 9,4 Z M2,19 C2,15 5,13 9,13 C13,13 16,15 16,19 Z M16.5,5.5 A2.5,2.5 0 0 1 16.5,10.5 A2.5,2.5 0 0 1 16.5,5.5 Z M17.5,13.2 C20.2,13.8 22,15.6 22,19 L17.8,19 C17.8,16.9 17.3,14.9 16.2,13.4 C16.6,13.3 17,13.2 17.5,13.2 Z</StreamGeometry>
    <StreamGeometry x:Key="IconTrash">M9,3 L15,3 L15,5 L20,5 L20,7 L4,7 L4,5 L9,5 Z M6,9 L18,9 L17,21 L7,21 Z</StreamGeometry>
    <StreamGeometry x:Key="IconSearch">M10,3 A7,7 0 0 1 15.6,14.2 L21,19.6 L19.6,21 L14.2,15.6 A7,7 0 1 1 10,3 Z M10,5 A5,5 0 1 0 10,15 A5,5 0 1 0 10,5 Z</StreamGeometry>
    <StreamGeometry x:Key="IconWave">M11,3 L13,3 L13,21 L11,21 Z M7,7 L9,7 L9,17 L7,17 Z M15,6 L17,6 L17,18 L15,18 Z M3,10 L5,10 L5,14 L3,14 Z M19,9 L21,9 L21,15 L19,15 Z</StreamGeometry>
    <StreamGeometry x:Key="IconGauge">M12,5 A8,8 0 0 0 4,13 L6.5,13 A5.5,5.5 0 0 1 17.5,13 L20,13 A8,8 0 0 0 12,5 Z M15.8,8.7 L12.6,13.2 A1.6,1.6 0 1 1 11.2,12.2 Z M4,15 L20,15 L20,17 L4,17 Z</StreamGeometry>
    </ResourceDictionary>
  </Window.Resources>

  <Window.Styles>
    <!--
      The motion vocabulary, used sparingly: presses compress and spring back with a slight
      overshoot, reveals fade, progress glides. Every animation answers an action or reports
      a state; nothing moves on its own.
    -->
    <Style Selector="Button.toolbar">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="RenderTransform" Value="scale(1)" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="BackEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.toolbar:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverFill}" />
    </Style>
    <Style Selector="Button.toolbar:pressed">
      <Setter Property="RenderTransform" Value="scale(0.93)" />
    </Style>
    <Style Selector="Button.toolbar:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PressFill}" />
    </Style>
    <!-- Unavailable reads as faded, not as a grey slab: the Fluent default fills disabled
         buttons, which in a quiet toolbar makes the things you cannot do the loudest. -->
    <Style Selector="Button.toolbar:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.toolbar:disabled">
      <Setter Property="Opacity" Value="0.35" />
    </Style>
    <Style Selector="Button.toolbar.icon">
      <Setter Property="Padding" Value="8,7" />
    </Style>
    <Style Selector="Button.toolbar.chip">
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="FontSize" Value="11.5" />
    </Style>

    <Style Selector="TextBox.search">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="6,5,8,5" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="{DynamicResource FieldBg}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox.search:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{DynamicResource HoverFill}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox.search:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{DynamicResource WindowBg}" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
    </Style>


    <Style Selector="TextBlock.stepLabel">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.stepState">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Margin" Value="6,0,0,0" />
      <Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
    </Style>
    <Style Selector="ProgressBar.step">
      <Setter Property="Minimum" Value="0" />
      <Setter Property="Maximum" Value="1" />
      <Setter Property="Height" Value="3" />
      <Setter Property="MinHeight" Value="3" />
      <Setter Property="CornerRadius" Value="2" />
    </Style>

    <Style Selector="Border.player">
      <Setter Property="Background" Value="{DynamicResource PlayerBg}" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="10,8" />
    </Style>

    <!-- The one filled control in the window: the thing a listener reaches for. -->
    <Style Selector="Button.play">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="RenderTransform" Value="scale(1)" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="BackEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.play /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.play:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SystemAccentColorLight1}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.play:pressed">
      <Setter Property="RenderTransform" Value="scale(0.92)" />
    </Style>
    <Style Selector="Button.play:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SystemAccentColorDark1}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.play:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverFill}" />
    </Style>

    <!-- The working glow's halo breathes — a slow swell under the rotating sweep, so the
         border reads as light rather than as a spinning line. -->
    <Style Selector="Border.breathing">
      <Style.Animations>
        <Animation Duration="0:0:2.4" IterationCount="INFINITE" Easing="SineEaseInOut">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0.35" />
          </KeyFrame>
          <KeyFrame Cue="50%">
            <Setter Property="Opacity" Value="0.75" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="0.35" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <!-- The recording dot breathes while the microphone is live — state you can see from
         across the room, which a static red dot does not give. -->
    <Style Selector="Ellipse.pulse">
      <Style.Animations>
        <Animation Duration="0:0:1.4" IterationCount="INFINITE" Easing="SineEaseInOut">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="1" />
          </KeyFrame>
          <KeyFrame Cue="50%">
            <Setter Property="Opacity" Value="0.25" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <!-- Appearing panels fade in rather than popping; see Reveal() in the code-behind. -->
    <Style Selector="Control.reveal, Border.reveal, ContentControl.reveal">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.25" Easing="QuadraticEaseOut" />
        </Transitions>
      </Setter>
    </Style>

    <Style Selector="ProgressBar">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Value" Duration="0:0:0.3" Easing="QuadraticEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.toolbar PathIcon">
      <Setter Property="Width" Value="15" />
      <Setter Property="Height" Value="15" />
    </Style>
    <Style Selector="Button.toolbar TextBlock">
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.toolbar StackPanel">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Spacing" Value="6" />
    </Style>

    <!-- The card marks the paragraph under the pointer and nothing more. It once wore a
         hand cursor and a press squeeze, from when a click anywhere on it played; the text
         is selectable now, so the words show the text cursor, and the word a click would
         play from is underlined as the pointer crosses it (see BuildWordBlock). A hand on
         the margins promised a click that did nothing. -->
    <Style Selector="Border.paragraph">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.paragraph:pointerover">
      <Setter Property="Background" Value="#0E808080" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">

    <!--
      The title bar carries the whole toolbar, shared with the traffic lights. Recording verbs
      on the left keep their words because they start everything; the document's name sits in
      the middle, as in any Mac document window; the tools for the open transcript are glyphs
      on the right, named by their tooltips and again in the File menu.
    -->
    <Grid Grid.Row="0" x:Name="TitleBar" ColumnDefinitions="Auto,*,Auto" Height="52" Margin="84,0,12,0">
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
        <Button x:Name="OpenButton" Classes="toolbar" Click="OnOpenClicked"
                ToolTip.Tip="Open a recording or transcript (⌘O)">
          <StackPanel>
            <PathIcon Data="{StaticResource IconOpen}" />
            <TextBlock x:Name="OpenLabel" Text="Open" />
          </StackPanel>
        </Button>
        <Button x:Name="RecordButton" Classes="toolbar" Click="OnRecordClicked"
                ToolTip.Tip="Record from the microphone (⌘R)">
          <StackPanel>
            <Ellipse x:Name="RecordingDot" Classes="pulse" Width="8" Height="8"
                     Fill="#E5484D" VerticalAlignment="Center" IsVisible="False" />
            <PathIcon x:Name="RecordIcon" Data="{StaticResource IconMic}" />
            <TextBlock x:Name="RecordLabel" Text="Record" />
          </StackPanel>
        </Button>
      </StackPanel>

      <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                  Margin="12,0" Spacing="0" IsHitTestVisible="False">
        <TextBlock x:Name="TitleText" Text="LocalScribe" FontSize="13" FontWeight="SemiBold"
                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="SubtitleText" FontSize="11" Foreground="{DynamicResource SecondaryText}"
                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" IsVisible="False" />
      </StackPanel>

      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
        <TextBox x:Name="SearchBox" Classes="search" Width="170" Margin="0,0,6,0"
                 Watermark="Search" ToolTip.Tip="Search the transcript (⌘F)"
                 TextChanged="OnSearchChanged" KeyDown="OnSearchKeyDown">
          <TextBox.InnerLeftContent>
            <PathIcon Data="{StaticResource IconSearch}" Width="12" Height="12" Margin="9,0,0,0"
                      Foreground="{DynamicResource SecondaryText}" />
          </TextBox.InnerLeftContent>
        </TextBox>
        <Button x:Name="SpeakersButton" Classes="toolbar icon" ToolTip.Tip="Speakers — work them out again, told how many"
                AutomationProperties.Name="Speakers">
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight">
              <StackPanel Spacing="12" Width="240">
                <TextBlock Text="Speakers" Classes="flyoutTitle" />
                <TextBlock Text="How many people are talking?" FontSize="13" />
                <NumericUpDown x:Name="SpeakerCountBox" Minimum="1" Maximum="12" Increment="1"
                               Value="2" FormatString="0" FontSize="13" />
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                  <Button Content="Work it out" Click="OnSpeakersAutoClicked" FontSize="13"
                          ToolTip.Tip="Infer the count from the voices" />
                  <Button Content="Find" Click="OnSpeakersCountClicked" FontSize="13" Classes="accent" />
                </StackPanel>
              </StackPanel>
            </Flyout>
          </Button.Flyout>
          <PathIcon Data="{StaticResource IconPeople}" />
        </Button>
        <Button x:Name="PaceButton" Classes="toolbar icon" ToolTip.Tip="Pace — how much of the machine to spend"
                AutomationProperties.Name="Pace">
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight">
              <StackPanel Spacing="8" Width="290">
                <TextBlock Text="Pace" Classes="flyoutTitle" />
                <RadioButton x:Name="PaceLight" Content="Light" Tag="Light" FontSize="13" Click="OnPaceChosen" />
                <RadioButton x:Name="PaceBalanced" Content="Balanced" Tag="Balanced" FontSize="13" Click="OnPaceChosen" />
                <RadioButton x:Name="PaceFast" Content="Fast" Tag="Fast" FontSize="13" Click="OnPaceChosen" />
                <RadioButton x:Name="PaceFastest" Content="Fastest" Tag="Full" FontSize="13" Click="OnPaceChosen" />
                <TextBlock x:Name="PaceDetail" FontSize="12" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" />
              </StackPanel>
            </Flyout>
          </Button.Flyout>
          <PathIcon Data="{StaticResource IconGauge}" />
        </Button>
        <Border Width="1" Height="18" Background="{DynamicResource Separator}" Margin="5,0" />
        <Button x:Name="SaveButton" Classes="toolbar icon" Click="OnSaveClicked"
                ToolTip.Tip="Save — the transcript and its audio, together (⌘S)" AutomationProperties.Name="Save">
          <PathIcon Data="{StaticResource IconSave}" />
        </Button>
        <Button x:Name="ExportButton" Classes="toolbar icon" Click="OnExportClicked"
                ToolTip.Tip="Export — the words alone (⌘E)" AutomationProperties.Name="Export">
          <PathIcon Data="{StaticResource IconExport}" />
        </Button>
        <Button x:Name="DiscardButton" Classes="toolbar icon" Click="OnDiscardClicked"
                ToolTip.Tip="Discard — throw the transcript away" AutomationProperties.Name="Discard">
          <PathIcon Data="{StaticResource IconTrash}" />
        </Button>
      </StackPanel>
    </Grid>

    <!-- The working glow: a slow colour sweep around the transcript while models are busy
         behind it. Two rings share one rotating gradient — a blurred halo underneath gives
         the bloom, a crisp ring on top gives the edge. The status line says which stage;
         this says, at a glance, that anything is happening at all. -->
    <Panel Grid.Row="2" x:Name="AiGlowLayer" Margin="10,4,10,10" IsHitTestVisible="False"
           Opacity="0">
      <Panel.Transitions>
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.4" Easing="QuadraticEaseOut" />
        </Transitions>
      </Panel.Transitions>
      <Border x:Name="AiGlowHalo" BorderThickness="7" CornerRadius="14"
              Effect="blur(14)" />
      <Border x:Name="AiGlow" BorderThickness="2" CornerRadius="12" />
    </Panel>

    <!-- The reading column: a transcript is read like a page, and a line that runs the width
         of a wide window is one the eye loses on the way back. The scroll bar stays at the
         window's edge, where a Mac user reaches for it. -->
    <ScrollViewer Grid.Row="2" x:Name="TranscriptScroll" Margin="10,6,10,12">
      <StackPanel MaxWidth="780" Margin="20,0,20,8">
        <StackPanel x:Name="ParagraphsPanel" Spacing="4" />
        <TextBlock x:Name="ProvisionalTextBlock"
                   TextWrapping="Wrap" FontSize="15" LineHeight="25"
                   Foreground="{DynamicResource SecondaryText}" FontStyle="Italic" Margin="14,4,14,4" />
      </StackPanel>
    </ScrollViewer>

    <!-- What an empty window offers: the two ways in, and the promise that matters. -->
    <StackPanel Grid.Row="2" x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                Spacing="14" MaxWidth="460" Margin="20" Classes="reveal">
      <Border Width="64" Height="64" CornerRadius="32" HorizontalAlignment="Center"
              Background="{DynamicResource AccentWash}">
        <PathIcon Data="{StaticResource IconWave}" Width="28" Height="28"
                  Foreground="{DynamicResource SystemAccentColor}" />
      </Border>
      <TextBlock Text="Transcribe a recording" FontSize="20" FontWeight="SemiBold"
                 HorizontalAlignment="Center" />
      <TextBlock TextWrapping="Wrap" TextAlignment="Center" FontSize="13" LineHeight="19"
                 Foreground="{DynamicResource SecondaryText}"
                 Text="Open an audio or video file, or a saved transcript — or drop one here. Words, speakers and timing are worked out on this Mac, and nothing leaves it." />
      <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,4,0,0">
        <Button x:Name="EmptyOpenButton" Classes="accent" Click="OnOpenClicked" Padding="16,7">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <PathIcon Data="{StaticResource IconOpen}" Width="14" Height="14" Foreground="White" />
            <TextBlock Text="Open…" FontSize="13" />
          </StackPanel>
        </Button>
        <Button x:Name="EmptyRecordButton" Click="OnRecordClicked" Padding="16,7">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <PathIcon Data="{StaticResource IconMic}" Width="14" Height="14" />
            <TextBlock Text="Record" FontSize="13" />
          </StackPanel>
        </Button>
      </StackPanel>
    </StackPanel>

    <StackPanel Grid.Row="3" Margin="16,0,16,8">
      <!-- A run's steps, each with its own bar: they overlap and finish in no fixed order, so
           one bar for all of them could only ever show an invented number. The line below says
           what the reader can already do, because a progress bar otherwise reads as "wait". -->
      <StackPanel x:Name="StepsPanel" IsVisible="False" Classes="reveal" Spacing="7" Margin="4,0,4,10">
        <Grid ColumnDefinitions="*,16,*,16,*">
          <StackPanel Grid.Column="0" Spacing="4">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock x:Name="StepLabel0" Classes="stepLabel" />
              <TextBlock Grid.Column="1" x:Name="StepState0" Classes="stepState" />
            </Grid>
            <ProgressBar x:Name="StepBar0" Classes="step" />
          </StackPanel>
          <StackPanel Grid.Column="2" Spacing="4">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock x:Name="StepLabel1" Classes="stepLabel" />
              <TextBlock Grid.Column="1" x:Name="StepState1" Classes="stepState" />
            </Grid>
            <ProgressBar x:Name="StepBar1" Classes="step" />
          </StackPanel>
          <StackPanel Grid.Column="4" Spacing="4">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock x:Name="StepLabel2" Classes="stepLabel" />
              <TextBlock Grid.Column="1" x:Name="StepState2" Classes="stepState" />
            </Grid>
            <ProgressBar x:Name="StepBar2" Classes="step" />
          </StackPanel>
        </Grid>
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock x:Name="ProgressHintText" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"
                     Foreground="{DynamicResource SecondaryText}" IsVisible="False" />
          <!-- Here because this is where someone decides to go and do something else. -->
          <CheckBox Grid.Column="1" x:Name="AlertCheck" Content="Alert me when it's done" FontSize="12"
                    MinHeight="0" Padding="6,0,0,0" Margin="12,0,0,0" VerticalAlignment="Center"
                    Foreground="{DynamicResource SecondaryText}" Click="OnAlertToggled"
                    ToolTip.Tip="A notification and a Dock bounce when this run ends, if you're in another app" />
        </Grid>
      </StackPanel>
      <!-- The transport lives with the thing it transports: a player-shaped card, not a
           toolbar verb. -->
      <Border x:Name="TransportRow" Classes="player" IsVisible="False">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Button Grid.Column="0" x:Name="PlayPauseButton" Classes="play" Click="OnPlayPauseClicked"
                  VerticalAlignment="Center" Margin="0,0,12,0"
                  ToolTip.Tip="Play or pause" AutomationProperties.Name="Play or pause">
            <PathIcon x:Name="PlayPauseIcon" Data="{StaticResource IconPlay}" Width="14" Height="14" Foreground="White" />
          </Button>
          <ContentControl Grid.Column="1" x:Name="WaveformHost" Height="44" VerticalAlignment="Center" />
          <TextBlock Grid.Column="2" x:Name="TimeReadout" VerticalAlignment="Center"
                     Margin="12,0,4,0" FontSize="12" Foreground="{DynamicResource SecondaryText}"
                     FontFamily="Menlo, monospace" Text="0:00 / 0:00" />
        </Grid>
      </Border>
      <ProgressBar x:Name="WorkProgress" Minimum="0" Maximum="1" Height="3" MinHeight="3"
                   CornerRadius="2" Margin="4,8,4,0" IsVisible="False" />
    </StackPanel>

    <!-- The status gets the line; the models get a chip. Two full sentences side by side
         left neither readable, and the model roster is a question asked now and then — "is
         it on the Neural Engine?" — while the status is read constantly. The chip names the
         models in a word each and opens the full roster on click. -->
    <Border Grid.Row="4" BorderBrush="{DynamicResource Separator}" BorderThickness="0,1,0,0" Padding="18,4,10,4">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" x:Name="StatusText" FontSize="12"
                   Foreground="{DynamicResource SecondaryText}"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
        <Button Grid.Column="1" x:Name="ModelsChip" Classes="toolbar chip"
                IsVisible="False" ToolTip.Tip="The models doing the work, and where each runs">
          <Button.Flyout>
            <Flyout Placement="TopEdgeAlignedRight">
              <StackPanel x:Name="ModelsPanel" Spacing="10" Width="340" />
            </Flyout>
          </Button.Flyout>
          <StackPanel x:Name="ModelsChipRow" Orientation="Horizontal" />
        </Button>
      </Grid>
    </Border>

  </Grid>

</Window>
