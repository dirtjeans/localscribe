<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LocalScribe.Desktop.MainWindow"
        Title="LocalScribe"
        Width="960" Height="700"
        MinWidth="560" MinHeight="400">

  <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Margin="16">

    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
      <Button x:Name="OpenButton" Click="OnOpenClicked" Content="Open…" />
      <Button x:Name="RecordButton" Click="OnRecordClicked" Content="Record" />
      <Button x:Name="PlayButton" Click="OnPlayClicked" Content="Play" />
      <Button x:Name="SaveButton" Click="OnSaveClicked" Content="Save…" />
      <Button x:Name="ExportButton" Click="OnExportClicked" Content="Export…" />
      <Button x:Name="SpeakersButton" Click="OnSpeakersClicked" Content="Speakers…" />
      <Button x:Name="DiscardButton" Click="OnDiscardClicked" Content="Discard" />
      <TextBlock x:Name="HardwareText" VerticalAlignment="Center" Opacity="0.6" FontSize="12"
                 Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
    </StackPanel>

    <StackPanel Grid.Row="1">
      <Border x:Name="CleanupOffer" IsVisible="False"
              Background="#20808080" CornerRadius="6" Padding="10,6" Margin="0,8,0,0">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" FontSize="13"
                     Text="No cleanup model is running, so transcripts keep their raw punctuation." />
          <Button x:Name="FoundryButton" Click="OnFoundryClicked" FontSize="13"
                  Content="Download and start Foundry Local" />
        </StackPanel>
      </Border>
      <TextBlock x:Name="SpeakerBadge" Opacity="0.6" FontSize="12" Margin="0,6,0,0" />
    </StackPanel>

    <ScrollViewer Grid.Row="2" x:Name="TranscriptScroll" Margin="0,10,0,10">
      <StackPanel>
        <StackPanel x:Name="ParagraphsPanel" Spacing="10" />
        <TextBlock x:Name="ProvisionalTextBlock"
                   TextWrapping="Wrap" FontSize="15" LineHeight="24"
                   Opacity="0.55" FontStyle="Italic" Margin="12,4,12,4" />
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="3">
      <ContentControl x:Name="WaveformHost" Height="56" Margin="0,0,0,8" IsVisible="False" />
      <ProgressBar x:Name="WorkProgress" Minimum="0" Maximum="1" Height="4"
                   Margin="0,0,0,6" IsVisible="False" />
    </StackPanel>

    <TextBlock Grid.Row="4" x:Name="StatusText" Opacity="0.75" FontSize="13"
               TextTrimming="CharacterEllipsis" />

  </Grid>

</Window>
