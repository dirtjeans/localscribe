<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LocalScribe.Desktop.MainWindow"
        Title="LocalScribe"
        Width="980" Height="720"
        MinWidth="600" MinHeight="420"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="52">

  <!--
    The chrome follows the platform rather than the Windows window: the toolbar shares the
    title bar with the traffic lights, buttons are quiet until hovered, and everything that
    can be clicked says so on approach. The *behaviours* stay the ported ones — the design is
    a coat, not a rewrite.
  -->

  <Window.Resources>
    <!-- Simple filled glyphs, drawn for 24×24. Kept as paths rather than a font so the app
         stays self-contained and the icons render identically on every machine. -->
    <StreamGeometry x:Key="IconOpen">M2,6 C2,4.9 2.9,4 4,4 L9,4 L11,6 L20,6 C21.1,6 22,6.9 22,8 L22,18 C22,19.1 21.1,20 20,20 L4,20 C2.9,20 2,19.1 2,18 Z</StreamGeometry>
    <StreamGeometry x:Key="IconMic">M12,3 A3,3 0 0 1 15,6 L15,11 A3,3 0 0 1 9,11 L9,6 A3,3 0 0 1 12,3 Z M7,11 A5,5 0 0 0 17,11 L19,11 A7,7 0 0 1 13,17.93 L13,21 L11,21 L11,17.93 A7,7 0 0 1 5,11 Z</StreamGeometry>
    <StreamGeometry x:Key="IconPlay">M8,5 L19,12 L8,19 Z</StreamGeometry>
    <StreamGeometry x:Key="IconStop">M7,7 L17,7 L17,17 L7,17 Z</StreamGeometry>
    <StreamGeometry x:Key="IconSave">M11,3 L13,3 L13,11 L16,11 L12,15 L8,11 L11,11 Z M4,17 L20,17 L20,19 L4,19 Z</StreamGeometry>
    <StreamGeometry x:Key="IconExport">M11,15 L13,15 L13,7 L16,7 L12,3 L8,7 L11,7 Z M4,17 L20,17 L20,19 L4,19 Z</StreamGeometry>
    <StreamGeometry x:Key="IconPeople">M9,4 A3,3 0 0 1 9,10 A3,3 0 0 1 9,4 Z M2,19 C2,15 5,13 9,13 C13,13 16,15 16,19 Z M16.5,5.5 A2.5,2.5 0 0 1 16.5,10.5 A2.5,2.5 0 0 1 16.5,5.5 Z M17.5,13.2 C20.2,13.8 22,15.6 22,19 L17.8,19 C17.8,16.9 17.3,14.9 16.2,13.4 C16.6,13.3 17,13.2 17.5,13.2 Z</StreamGeometry>
    <StreamGeometry x:Key="IconTrash">M9,3 L15,3 L15,5 L20,5 L20,7 L4,7 L4,5 L9,5 Z M6,9 L18,9 L17,21 L7,21 Z</StreamGeometry>
  </Window.Resources>

  <Window.Styles>
    <!--
      The motion vocabulary, used sparingly: presses compress and spring back with a slight
      overshoot, reveals fade, progress glides. Every animation answers an action or reports
      a state; nothing moves on its own.
    -->
    <Style Selector="Button.toolbar">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="RenderTransform" Value="scale(1)" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="BackEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.toolbar:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#18808080" />
    </Style>
    <Style Selector="Button.toolbar:pressed">
      <Setter Property="RenderTransform" Value="scale(0.93)" />
    </Style>
    <Style Selector="Button.toolbar:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#28808080" />
    </Style>

    <!-- The working glow's halo breathes — a slow swell under the rotating sweep, so the
         border reads as light rather than as a spinning line. -->
    <Style Selector="Border.breathing">
      <Style.Animations>
        <Animation Duration="0:0:2.4" IterationCount="INFINITE" Easing="SineEaseInOut">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0.35" />
          </KeyFrame>
          <KeyFrame Cue="50%">
            <Setter Property="Opacity" Value="0.75" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="0.35" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <!-- The recording dot breathes while the microphone is live — state you can see from
         across the room, which a static red dot does not give. -->
    <Style Selector="Ellipse.pulse">
      <Style.Animations>
        <Animation Duration="0:0:1.4" IterationCount="INFINITE" Easing="SineEaseInOut">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="1" />
          </KeyFrame>
          <KeyFrame Cue="50%">
            <Setter Property="Opacity" Value="0.25" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <!-- Appearing panels fade in rather than popping; see Reveal() in the code-behind. -->
    <Style Selector="Control.reveal, Border.reveal, ContentControl.reveal">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.25" Easing="QuadraticEaseOut" />
        </Transitions>
      </Setter>
    </Style>

    <Style Selector="ProgressBar">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Value" Duration="0:0:0.3" Easing="QuadraticEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.toolbar PathIcon">
      <Setter Property="Width" Value="15" />
      <Setter Property="Height" Value="15" />
    </Style>
    <Style Selector="Button.toolbar TextBlock">
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.toolbar StackPanel">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Spacing" Value="6" />
    </Style>

    <!-- The paragraph cards say "clickable" on approach and change softly, never abruptly;
         a press compresses the card a hair, so the click that starts playback lands. -->
    <Style Selector="Border.paragraph">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="RenderTransform" Value="scale(1)" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.12" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="BackEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.paragraph:pointerover">
      <Setter Property="Background" Value="#0E808080" />
    </Style>
    <Style Selector="Border.paragraph.pressed">
      <Setter Property="RenderTransform" Value="scale(0.992)" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">

    <!-- Shares the title bar; the left margin leaves room for the traffic lights. -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="84,8,16,8">
    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2"
                VerticalAlignment="Center">
      <Button x:Name="OpenButton" Classes="toolbar" Click="OnOpenClicked" ToolTip.Tip="Open a recording or transcript">
        <StackPanel>
          <PathIcon Data="{StaticResource IconOpen}" />
          <TextBlock Text="Open" />
        </StackPanel>
      </Button>
      <Button x:Name="RecordButton" Classes="toolbar" Click="OnRecordClicked" ToolTip.Tip="Record from the microphone">
        <StackPanel>
          <Ellipse x:Name="RecordingDot" Classes="pulse" Width="8" Height="8"
                   Fill="#E5484D" VerticalAlignment="Center" IsVisible="False" />
          <PathIcon x:Name="RecordIcon" Data="{StaticResource IconMic}" />
          <TextBlock x:Name="RecordLabel" Text="Record" />
        </StackPanel>
      </Button>
      <Button x:Name="PlayButton" Classes="toolbar" Click="OnPlayClicked" ToolTip.Tip="Play the recording">
        <StackPanel>
          <PathIcon x:Name="PlayIcon" Data="{StaticResource IconPlay}" />
          <TextBlock x:Name="PlayLabel" Text="Play" />
        </StackPanel>
      </Button>
      <Border Width="1" Height="18" Background="#30808080" Margin="6,0" />
      <Button x:Name="SaveButton" Classes="toolbar" Click="OnSaveClicked" ToolTip.Tip="Save transcript and audio together">
        <StackPanel>
          <PathIcon Data="{StaticResource IconSave}" />
          <TextBlock Text="Save" />
        </StackPanel>
      </Button>
      <Button x:Name="ExportButton" Classes="toolbar" Click="OnExportClicked" ToolTip.Tip="Export the words alone">
        <StackPanel>
          <PathIcon Data="{StaticResource IconExport}" />
          <TextBlock Text="Export" />
        </StackPanel>
      </Button>
      <Button x:Name="SpeakersButton" Classes="toolbar" ToolTip.Tip="Work out the speakers again, told how many">
        <Button.Flyout>
          <Flyout Placement="Bottom">
            <StackPanel Spacing="10" Width="230">
              <TextBlock Text="How many people are talking?" FontSize="13" />
              <NumericUpDown x:Name="SpeakerCountBox" Minimum="1" Maximum="12" Increment="1"
                             Value="2" FormatString="0" FontSize="13" />
              <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Content="Work it out" Click="OnSpeakersAutoClicked" FontSize="13"
                        ToolTip.Tip="Infer the count from the voices" />
                <Button Content="Find" Click="OnSpeakersCountClicked" FontSize="13" />
              </StackPanel>
            </StackPanel>
          </Flyout>
        </Button.Flyout>
        <StackPanel>
          <PathIcon Data="{StaticResource IconPeople}" />
          <TextBlock Text="Speakers" />
        </StackPanel>
      </Button>
      <Button x:Name="DiscardButton" Classes="toolbar" Click="OnDiscardClicked" ToolTip.Tip="Throw the transcript away">
        <StackPanel>
          <PathIcon Data="{StaticResource IconTrash}" />
          <TextBlock Text="Discard" />
        </StackPanel>
      </Button>
    </StackPanel>

    <TextBox Grid.Column="1" x:Name="SearchBox" Width="190" FontSize="13"
             CornerRadius="7" VerticalAlignment="Center"
             Watermark="Search transcript (⌘F)"
             TextChanged="OnSearchChanged" KeyDown="OnSearchKeyDown" />
    </Grid>

    <StackPanel Grid.Row="1" Margin="20,0,20,0">
      <Border x:Name="CleanupOffer" IsVisible="False"
              Background="#20808080" CornerRadius="8" Padding="12,8" Margin="0,8,0,0">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" FontSize="13"
                     Text="No cleanup model is running, so transcripts keep their raw punctuation." />
          <Button x:Name="FoundryButton" Click="OnFoundryClicked" FontSize="13"
                  Content="Download and start Foundry Local" />
        </StackPanel>
      </Border>
      <TextBlock x:Name="SpeakerBadge" Opacity="0.55" FontSize="12" Margin="0,6,0,0" />
    </StackPanel>

    <!-- The working glow: a slow colour sweep around the transcript while models are busy
         behind it. Two rings share one rotating gradient — a blurred halo underneath gives
         the bloom, a crisp ring on top gives the edge. The status line says which stage;
         this says, at a glance, that anything is happening at all. -->
    <Panel Grid.Row="2" x:Name="AiGlowLayer" Margin="8,10,8,10" IsHitTestVisible="False"
           Opacity="0">
      <Panel.Transitions>
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.4" Easing="QuadraticEaseOut" />
        </Transitions>
      </Panel.Transitions>
      <Border x:Name="AiGlowHalo" BorderThickness="7" CornerRadius="12"
              Effect="blur(14)" />
      <Border x:Name="AiGlow" BorderThickness="2" CornerRadius="10" />
    </Panel>

    <ScrollViewer Grid.Row="2" x:Name="TranscriptScroll" Margin="10,12,10,12" Padding="12,0">
      <StackPanel>
        <StackPanel x:Name="ParagraphsPanel" Spacing="8" />
        <TextBlock x:Name="ProvisionalTextBlock"
                   TextWrapping="Wrap" FontSize="15" LineHeight="24"
                   Opacity="0.55" FontStyle="Italic" Margin="12,4,12,4" />
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="3" Margin="20,0,20,0">
      <ContentControl x:Name="WaveformHost" Height="56" Margin="0,0,0,8" IsVisible="False" />
      <ProgressBar x:Name="WorkProgress" Minimum="0" Maximum="1" Height="4"
                   Margin="0,0,0,6" IsVisible="False" />
    </StackPanel>

    <!-- Status on the left, the running models on the right: "is it using the Neural
         Engine?" is the question everyone asks, and the answer lives where status lives. -->
    <Border Grid.Row="4" BorderBrush="#20808080" BorderThickness="0,1,0,0" Padding="20,7">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" x:Name="StatusText" Opacity="0.7" FontSize="12.5"
                   TextTrimming="CharacterEllipsis" Margin="0,0,16,0" />
        <TextBlock Grid.Column="1" x:Name="HardwareText" Opacity="0.45" FontSize="12"
                   TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" />
      </Grid>
    </Border>

  </Grid>

</Window>
